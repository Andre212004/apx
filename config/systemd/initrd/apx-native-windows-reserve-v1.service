[Unit]
Description=APX one-shot offline native Windows storage reservation
DefaultDependencies=no
ConditionKernelCommandLine=apx.native_windows_reserve=1
Requires=apx-native-windows-probe-v1.service
After=apx-native-windows-probe-v1.service
After=dev-mapper-cryptroot.device systemd-cryptsetup@cryptroot.service
After=systemd-fsck@dev-mapper-cryptroot.service
Before=sysroot.mount initrd-root-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/apx-native-windows-maintenance-initrd-v1
StandardInput=null
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=infinity
