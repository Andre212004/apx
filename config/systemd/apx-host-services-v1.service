[Unit]
Description=APX read-only Host desktop-essential status v1
After=local-fs.target iwd.service systemd-networkd.service

[Service]
Type=simple
ExecStart=/usr/bin/python /usr/lib/apx/apx-host-services-v1.py --serve
Restart=on-failure
RestartSec=1s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/apx
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
