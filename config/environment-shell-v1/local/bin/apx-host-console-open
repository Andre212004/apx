#!/usr/bin/python3
"""Open or focus the one deterministic APX Host-console window."""

from __future__ import annotations

import json
import os
import socket
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/apx")
from apx_host_console_contract import MAX_MESSAGE_BYTES, parse_message, request_bytes  # noqa: E402

SOCKET = "/run/apx/host-console-v1.sock"
WINDOW_CLASS = "apx-host-console-v1"


def focus_existing() -> bool:
    clients = subprocess.run(("/usr/bin/hyprctl", "clients"), text=True,
                             capture_output=True, check=False)
    if clients.returncode or f"class: {WINDOW_CLASS}" not in clients.stdout:
        return False
    focus = subprocess.run((
        "/usr/bin/hyprctl", "eval",
        f'local w = hl.get_window("class:^({WINDOW_CLASS})$"); '
        "if w then hl.dispatch(hl.dsp.focus({ window = w })) end",
    ), capture_output=True, check=False)
    return focus.returncode == 0


def ticket() -> str:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.connect(SOCKET)
        connection.sendall(request_bytes("console.ticket", {}))
        data = bytearray()
        while b"\n" not in data and len(data) <= MAX_MESSAGE_BYTES:
            chunk = connection.recv(4096)
            if not chunk:
                break
            data.extend(chunk)
    value = parse_message(bytes(data))
    if value.get("ok") is not True or type(value.get("result")) is not dict:
        raise RuntimeError(str(value.get("error", "Host-console ticket refused")))
    token = value["result"].get("ticket")
    if type(token) is not str:
        raise RuntimeError("Host-console ticket differs")
    return token


def main() -> int:
    if focus_existing():
        return 0
    environment = os.environ.copy()
    environment["APX_HOST_CONSOLE_TICKET"] = ticket()
    subprocess.Popen((
        "/usr/bin/kitty", "--class", WINDOW_CLASS, "--title", "APX HOST ROOT",
        "/home/apx/.local/bin/apx-host-console-terminal",
    ), env=environment, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
       stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(60):
        if focus_existing():
            return 0
        time.sleep(0.05)
    return 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, ValueError) as error:
        print(f"APX Host console launch failed: {error}", file=sys.stderr)
        raise SystemExit(3)
