#!/usr/bin/python3
"""Dismiss terminal notifications when their application regains focus."""

from __future__ import annotations

import glob
import json
import os
from pathlib import Path
import socket
import subprocess
import time


TERMINAL_APPS = {"kitty", "alacritty"}
MAKOCTL = "/usr/bin/makoctl"
HYPRCTL = "/usr/bin/hyprctl"


def dismiss_terminal_notifications() -> None:
    try:
        result = subprocess.run(
            [MAKOCTL, "list", "-j"],
            check=True,
            capture_output=True,
            text=True,
            timeout=2,
        )
        notifications = json.loads(result.stdout)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        return

    for notification in notifications:
        if str(notification.get("app_name", "")).casefold() not in TERMINAL_APPS:
            continue
        notification_id = notification.get("id")
        if not isinstance(notification_id, int):
            continue
        try:
            subprocess.run(
                [MAKOCTL, "dismiss", "-n", str(notification_id), "--no-history"],
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=2,
            )
        except (OSError, subprocess.SubprocessError):
            pass


def focused_class(signature: str) -> str:
    environment = os.environ.copy()
    environment["HYPRLAND_INSTANCE_SIGNATURE"] = signature
    try:
        result = subprocess.run(
            [HYPRCTL, "activewindow", "-j"],
            check=True,
            capture_output=True,
            text=True,
            timeout=2,
            env=environment,
        )
        return str(json.loads(result.stdout).get("class", "")).casefold()
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        return ""


def event_sockets() -> list[Path]:
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if signature:
        candidate = Path(runtime) / "hypr" / signature / ".socket2.sock"
        return [candidate] if candidate.is_socket() else []
    return [Path(value) for value in glob.glob(f"{runtime}/hypr/*/.socket2.sock")]


def monitor(path: Path) -> None:
    signature = path.parent.name
    if focused_class(signature) in TERMINAL_APPS:
        dismiss_terminal_notifications()

    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as stream:
        stream.connect(str(path))
        with stream.makefile("r", encoding="utf-8", errors="replace") as events:
            for line in events:
                if not line.startswith("activewindow>>"):
                    continue
                window_class = line.removeprefix("activewindow>>").split(",", 1)[0]
                if window_class.strip().casefold() in TERMINAL_APPS:
                    dismiss_terminal_notifications()


def main() -> None:
    while True:
        paths = event_sockets()
        if not paths:
            time.sleep(1)
            continue
        try:
            monitor(paths[0])
        except (OSError, ValueError):
            time.sleep(1)


if __name__ == "__main__":
    main()
